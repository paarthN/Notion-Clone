# Clerk (Dashboard → API keys). Use the free Hobby plan.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Convex (`npx convex dev` prints this URL). Use the free plan.
NEXT_PUBLIC_CONVEX_URL=

# Set on the Convex deployment, not only here:
# npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=

# Embedded sign-in, so Clerk does not send people to the hosted account portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app
